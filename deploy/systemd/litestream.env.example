# Litestream replication environment for systemd.
#
# Install as /etc/flow-api/litestream.env (root:flow-api, mode 0640).
# Only litestream.service reads this file, so R2 credentials never reach the
# flow-api process. Never commit real Cloudflare R2 credentials.

# Database replicated by Litestream. Must match DB_PATH in flow-api.env.
LITESTREAM_DB_PATH=/var/lib/flow-api/flow.db

# Cloudflare R2 destination for Litestream.
# R2_ACCOUNT_ID is the Cloudflare account ID, not the R2 access key.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PREFIX=flow-api
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
