# Flow API runtime environment for systemd.
#
# Install as /etc/flow-api/flow-api.env (root:flow-api, mode 0640).
# Only flow-api.service reads this file. Litestream and Cloudflare R2 settings
# live in /etc/flow-api/litestream.env, which only litestream.service reads.
# Never commit real credentials.

# HTTP listener. Bind loopback and put a reverse proxy in front for TLS.
HTTP_ADDR=127.0.0.1:8080
DB_PATH=/var/lib/flow-api/flow.db

# Read pool connections. The service clamps this to [4, 6]; 5 is the default.
DB_READ_CONNS=5

# Domain defaults applied to newly created accounts.
DEFAULT_INITIAL_BALANCE=1000
DEFAULT_RATE_LIMIT_RPM=120
DEFAULT_REQUEST_COST=1

# Grace period for HTTP shutdown plus batcher Drain (8192 slots).
SHUTDOWN_TIMEOUT=10s

# Time allowed for in-flight requests to drain after SIGTERM.
DRAIN_TIMEOUT=10s

# Warn when the WAL grows beyond 64 MiB.
WAL_WARN_BYTES=67108864

# Maximum number of accounts the service accepts.
MAX_ACCOUNTS=4096

# Bootstrap administrator key. Change it before exposing the service.
ADMIN_API_KEY=change-me-admin-api-key

# Optional bootstrap account keys, in name:key form.
# API_KEYS=default:change-me-account-key
